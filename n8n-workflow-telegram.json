    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst callbackData = data.callback_query?.data || '';\nconst chatId = data.callback_query?.message?.chat?.id;\nconst messageId = data.callback_query?.message?.message_id;\n\n// callback_data format: year_{academicYear}_{specialization}_{studentNumber}\nconst parts = callbackData.split('_');\n\nlet academicYear = '';\nlet specialization = null;\nlet studentNumber = '';\n\nif (parts.length >= 4 && parts[0] === 'year') {\n  academicYear = parts[1];\n  specialization = parts[2] === 'none' ? null : parts[2];\n  studentNumber = parts[3];\n}\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    message_id: messageId,\n    student_number: studentNumber,\n    academic_year: academicYear,\n    specialization: specialization,\n    department_id: '2'\n  }\n}];"
      },
